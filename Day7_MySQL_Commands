##CREATE: CREATE makes a new database object
-- Create a database: CREATE DATABASE quickcart_dev;
                    CREATE DATABASE IF NOT EXISTS quickcart_dev; -- IF NOT EXISTS prevents an error when the database already exists aythee
-- Create a table
CREATE TABLE customers (
    customer_id INT PRIMARY KEY,
    full_name VARCHAR(100),
    email VARCHAR(255)
);

-- Create an index
CREATE INDEX idx_customers_email
ON customers (email);

-- Create a view
CREATE VIEW active_customers AS
SELECT
    customer_id,
    full_name,
    email
FROM customers
WHERE status = 'ACTIVE';

CREATE DATABASE ->create a container
CREATE TABLE    -> create a data structure
CREATE INDEX    - Create an access path
CREATE VIEW     -> create a stored query definition

##ALTER- ALTER changes an existing object
-- Typical table changes include: Add a column
                                Remove a column
                                Rename a column
                                Change a column definition
                                Add a constraint
                                Remove a constraint
                                Add an index
                                Remove an index
-- Add a column
ALTER TABLE customers
ADD COLUMN phone VARCHAR(20);

-- Rename a column
ALTER TABLE customers
RENAME COLUMN phone TO mobile_number;

-- Remove a column
ALTER TABLE customers
DROP COLUMN mobile_number;

-- Add a constraint
ALTER TABLE customers
ADD CONSTRAINT uq_customers_email
UNIQUE (email);

##RENAME: Renames an object
RENAME TABLE customers TO application_customers;

-- You can also rename a column through ALTER TABLE:
ALTER TABLE application_customers
RENAME COLUMN full_name TO customer_name;

##TRUNCATE: Removes every row from a table while retaining the table definition
TRUNCATE TABLE customers;

It does not accept a WHERE condition:
TRUNCATE TABLE customers
WHERE status = 'INACTIVE'; -- Invalid

-- Use it for situations such as:
-> Clearing a disposable staging table
-> Resetting an isolated development table
-> Removing all temporary imported data
-> Do not casually use it on a production transactional table

# DROP: Destroys an object
-- Drop a table
DROP TABLE customers; -- This removes: mana table definition, All rows, Indexes, constraints belonging to the table

-- Drop a database
DROP DATABASE quickcart_dev; -- it removes the database and its objects

-- Safer syntax during setup scripts:
DROP TABLE IF EXISTS command_demo; -- Ikkada IF EXISTS prevents an error anthee, it does not make the operation safe

-- DDL transaction warning chudnadii(ou should not expect a later ROLLBACK to restore the previous structure)
START TRANSACTION;
UPDATE customers
SET status = 'INACTIVE'
WHERE customer_id = 10;

ALTER TABLE customers
ADD COLUMN notes VARCHAR(500);
ROLLBACK;

