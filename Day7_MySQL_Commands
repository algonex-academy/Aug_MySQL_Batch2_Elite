##DELETE: Removes rows
DELETE FROM customers
WHERE customer_id = 4;

-- Dangerous deletion
DELETE FROM customers; -- This targets every row
Unlike TRUNCATE, it is still a DELETE statement, and on a transactional table such as InnoDB, it can be rolled back if it remains inside an uncommitted transaction.

-- Safe deletion pattern
SELECT
    customer_id,
    full_name,
    email
FROM customers
WHERE customer_id = 4;
START TRANSACTION;

DELETE FROM customers
WHERE customer_id = 4;

SELECT
    customer_id,
    full_name,
    email
FROM customers
WHERE customer_id = 4;

ROLLBACK; -- The row should return after the rollback




