SELECT
    sales_rep, total_sales,
    RANK() OVER(
        ORDER BY total_sales DESC
    ) AS sales_rank
FROM (
    SELECT
        sales_rep,
        SUM(quantity * unit_price) AS total_sales
    FROM orders
    GROUP BY sales_rep
) t; -- Oka business report vachindaa?

7. Rank Customers by Total Spending
SELECT
    customer_id,customer_name, total_spending,
    DENSE_RANK() OVER(
        ORDER BY total_spending DESC
    ) AS customer_rank
FROM (
    SELECT
        customer_id,
        customer_name,
        SUM(quantity * unit_price) AS total_spending
    FROM orders
    GROUP BY customer_id, customer_name
) t; -- Which customers are our highest-value customers? ecommerce vallu baaga vadtharu

8. Top 3 Customers
SELECT *
FROM (
