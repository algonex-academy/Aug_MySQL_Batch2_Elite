        FROM orders
        GROUP BY customer_id, customer_name
    ) x
) y
WHERE customer_rank <= 3;

PART B — TOP N PER GROUP
9. Top 2 Customers in Every City(TCS Que)
SELECT * FROM (
    SELECT city, customer_id, customer_name, total_spending,
        DENSE_RANK() OVER(
            PARTITION BY city
            ORDER BY total_spending DESC
        ) AS city_rank
    FROM (
        SELECT city,customer_id, customer_name,
            SUM(quantity * unit_price) AS total_spending
        FROM orders
        GROUP BY city, customer_id, customer_name
    ) t
) x
WHERE city_rank <= 2;

-- PART C — AGGREGATE WINDOW FUNCTIONS
10. SUM() OVER()
Calculate total company sales while keeping every order
SELECT
    order_id,
    order_date,
    quantity * unit_price AS order_amount,
    SUM(quantity * unit_price) OVER() AS company_total_sales
FROM orders; -- Every row gets the same total

11. Department-style Grouping with PARTITION BY
SELECT
    order_id,
    category,
    quantity * unit_price AS order_amount,
    SUM(quantity * unit_price) OVER(
        PARTITION BY category
    ) AS category_total_sales
FROM orders;

-- individual order(Every Electronics order gets Electronics total)
                                    vs
category total(Every Accessories order gets Accessories total) without losing the individual row

12. Calculate Percentage Contribution
What percentage of category revenue did each order contribute?
SELECT order_id,category,
    quantity * unit_price AS order_amount,
    SUM(quantity * unit_price) OVER(
        PARTITION BY category) AS category_total,
    ROUND(quantity * unit_price/ SUM(quantity * unit_price) OVER(
            PARTITION BY category) * 100,2) AS category_percentage
FROM orders;

13. Running Total
Show cumulative company revenue over time
SELECT order_date,order_id, quantity * unit_price AS order_amount,
    SUM(quantity * unit_price) OVER(
        ORDER BY order_date
    ) AS running_sales
FROM orders;

14. Running Total Per Customer
SELECT customer_id,customer_name,order_date,
    quantity * unit_price AS order_amount,
    SUM(quantity * unit_price) OVER(
        PARTITION BY customer_id
        ORDER BY order_date ) AS customer_running_total
FROM orders;

