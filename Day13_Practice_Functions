    quantity * unit_price AS order_amount,
    DENSE_RANK() OVER(
        ORDER BY quantity * unit_price DESC
    ) AS amount_rank
FROM orders;

6. RANK Employees by Sales: Let's calculate each salesperson's total sales first
SELECT
    sales_rep,
    SUM(quantity * unit_price) AS total_sales
FROM orders
GROUP BY sales_rep;

