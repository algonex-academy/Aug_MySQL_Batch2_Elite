SELECT
    column_list
FROM table_name
WHERE row_condition
GROUP BY grouping_columns
HAVING group_condition
ORDER BY sorting_columns
LIMIT row_count; -- Not every query requires every clause gurthupetkondii

-- Select specific columns
SELECT
    crew_id,
    full_name,
    email FROM Algonex_Crew;

-- Avoid this in production application queries:
SELECT * FROM Algonex_Crew; -- SELECT * can be useful during temporary exploration(Initialga Data chudadaaniki) but meeku production application code should normally request only what it needs

-- Filter with WHERE
SELECT
    crew_id,
    full_name,
    email
FROM Algonex_Crew
WHERE status = 'ACTIVE'; -- Gives 3 columns where status column is having 'ACTIVE' value

-- Multiple conditions:(AND)
SELECT
    crew_id,
    full_name,
    email
FROM Algonex_Crew
WHERE status = 'ACTIVE'
  AND city = 'Hyderabad'; -- Gives 3 column values where both conditions are satisfied 

-- Alternative condition: (OR)
SELECT
    crew_id,
    full_name
FROM Algonex_Crew
WHERE city = 'Hyderabad'
   OR city = 'Bengaluru'; 

-- Sort with ORDER BY(Asc/Desc)
SELECT
    crew_id,
    full_name
FROM Algonex_Crew
ORDER BY full_name ASC/DESC; -- But Asc is default

-- Multiple sort levels kosam:
SELECT
    crew_id,
    full_name,
    status
FROM Algonex_Crew
ORDER BY
    status ASC,
    full_name ASC;

-- Restrict results with LIMIT and OFFSET
SELECT
    customer_id,
    full_name,
    created_at
FROM Algonex_Crew
ORDER BY created_at DESC
LIMIT 5 OFFSET 2; -- Sort newest first and return the next five rows after 2 rows absence 
-- Without ORDER BY MySQL don't know which five rows should come first

-- Remove duplicate result values with DISTINCT
SELECT DISTINCT
    city
FROM Algonex_Crew
ORDER BY city; -- It does not remove duplicate rows from the table

-- Group rows using GROUP BY
SELECT
    status,
    COUNT(*) AS customer_count
FROM Algonex_Crew
GROUP BY status;

WHERE versus HAVING
--> WHERE filters individual rows and Filter rows before grouping
SELECT
    status,
    COUNT(*) AS customer_count
FROM Algonex_Crew
WHERE city = 'Hyderabad'
GROUP BY status;

--> HAVING filters grouped results and  Filter groups after grouping
SELECT
    city,
    COUNT(*) AS customer_count
FROM Algonex_Crew
GROUP BY city
HAVING COUNT(*) >= 10;

-- You write a query like this:                    But ogical model execution flow:
SELECT                                                 1. FROM / JOIN
FROM                                                   2. WHERE
JOIN                                                   3. GROUP BY
WHERE                                                  4. HAVING
GROUP BY                                               5. SELECT
HAVING                                                 6. DISTINCT
ORDER BY                                               7. ORDER BY
LIMIT                                                  8. LIMIT

SELECT
    city,
    COUNT(*) AS customer_count
FROM Algonex_Crew
WHERE status = 'ACTIVE'
GROUP BY city
HAVING COUNT(*) >= 10
ORDER BY customer_count DESC
LIMIT 5; -- Keep active customers
            -> Group them by city
            -> Calculate each group’s count
            -> Keep groups with at least ten customers
            -> Sort by count
            -> Return five groups

-- Ikkada MySQL optimizer physically executes every query in that exact sequence,MySQL requires clauses in their defined syntax positionsloone
for example HAVING follows GROUP BY and precedes ORDER BY

╰┈➤DELETE vs TRUNCATE vs DROP in MySQL
DELETE   ->Remove rows(DELETE removes rows from an existing table)
TRUNCATE -> Empty the table(TRUNCATE removes every row from the table very quickly)
DROP     -> Remove the table itself(DROP removes the entire database object)

DELETE is a DML command that removes selected or all rows and supports WHERE. With InnoDB, an uncommitted delete can be rolled back
-> TRUNCATE is a DDL command that quickly removes all rows, does not support WHERE, resets the auto-increment counterand causes an implicit commit
-> DROP is DDL and removes the entire table, including its data, structure, indexesand constraints

Do you need to remove only some rows?
├── Yes
│   └── Use DELETE with WHERE
└── No, remove all rows
    │
    ├── Should the table still exist?
       ├── Yes
       │   ├── Need transaction rollback or delete triggers?
       │   │   └── Use DELETE
       │   │
       │   └── Disposable data and reset identity?
       │       └── Use TRUNCATE
       └── No
            └── Use DROP

DELETE FROM employees WHERE employee_id = 10;
-> Remove one employee

TRUNCATE TABLE employees;
-> Keep the employees table, remove all employees

DROP TABLE employees;
-> Remove the employees table completely

