##CREATE: CREATE makes a new database object
-- Create a database: CREATE DATABASE quickcart_dev;
                    CREATE DATABASE IF NOT EXISTS quickcart_dev; -- IF NOT EXISTS prevents an error when the DB already exists 
-- Create a table
CREATE TABLE Algonex_crew (
    crew_id INT PRIMARY KEY,
    full_name VARCHAR(100),
    email VARCHAR(255)
);

-- Create an index
CREATE INDEX idx_customers_email
ON Algonex_crew (email);

-- Create a view
CREATE VIEW active_customers AS
SELECT
    crew_id,
    full_name,
    email
FROM Algonex_crew
WHERE status = 'ACTIVE';

CREATE DATABASE ->create a container
CREATE TABLE    -> create a data structure
CREATE INDEX    - Create an access path
CREATE VIEW     -> create a stored query definition

##ALTER- ALTER changes an existing DB objects
-- Typical table changes include: Add a column
                                Remove a column
                                Rename a column
                                Change a column definition
                                Add a constraint
                                Remove a constraint
                                Add an index
                                Remove an index
-- Add a column
ALTER TABLE customers
ADD COLUMN phone VARCHAR(20);

-- Rename a column
ALTER TABLE customers
RENAME COLUMN phone TO mobile_number;

-- Remove a column
ALTER TABLE customers
DROP COLUMN mobile_number;

-- Add a constraint
ALTER TABLE customers
ADD CONSTRAINT uq_customers_email
UNIQUE (email);

##RENAME: Renames a DB object names
RENAME TABLE Algonex TO AlgonexITSolutions; -- Table Renaming

-- You can also rename a column through ALTER TABLE:
ALTER TABLE Algonex_applications
RENAME COLUMN full_name TO Intern_name;

##TRUNCATE: Removes every row/data from a table while retaining the table definition
TRUNCATE TABLE Algonex_applications;

-- It does not accept a WHERE condition:
TRUNCATE TABLE Algonex_applications
WHERE status = 'INACTIVE'; -- Invalid

Use it for situations such as:
-> Clearing a disposable staging table
-> Resetting an isolated development table
-> Removing all temporary imported data
-> Do not casually use it on a production transactional table
=> The changes for TRUNCATE is permanent without any ROLLBACK/Backup for the row data

# DROP: Destroys an object from Database entirely
-- Drop a table
DROP TABLE Algonex_applications; -- This removes: mana table definition, All rows, Indexes, constraints belonging to the table

-- Drop a database
DROP DATABASE Algonex; -- it removes the database and its objects

-- Safer syntax during setup scripts:
DROP TABLE IF EXISTS Algonex; -- Ikkada IF EXISTS prevents an error anthee, it does not make the operation safe

-- DDL transaction warning chudnadii(You should not expect a later ROLLBACK to restore the previous structure)

