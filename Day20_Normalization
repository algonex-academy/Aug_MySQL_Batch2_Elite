For exampleki: Find customer name, order ID, product name and quantity
SELECT
    c.customer_name,
    o.order_id,                                    Normalization
    p.product_name,                                    |
    oi.quantity                                    Separate logical tables
FROM customers c                                       | 
JOIN orders o                                      Prmary Keys / Foreign Keys
    ON c.customer_id = o.customer_id                    |
JOIN order_items oi                                   JOINs
    ON o.order_id = oi.order_id                         | 
JOIN products p                                     Business queries
    ON oi.product_id = p.product_id;
