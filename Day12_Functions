-- Industry Example: Day-over-Day Sales Growth
SELECT
    order_date, sales,
    LAG(sales) OVER(
        ORDER BY order_date
    ) AS previous_sales
FROM daily_sales;

SELECT
    order_date, sales, previous_sales,sales - previous_sales AS sales_change
FROM (
    SELECT
        order_date,
        sales,
        LAG(sales) OVER(
            ORDER BY order_date
        ) AS previous_sales
    FROM daily_sales
) t;

