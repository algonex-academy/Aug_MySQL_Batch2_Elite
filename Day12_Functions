1. ROW_NUMBER() :Assigns a unique sequential number to every row
ROW_NUMBER() OVER (
    [PARTITION BY column]
    ORDER BY column
)

SELECT
    employee_name,
    department,
    salary,
    ROW_NUMBER() OVER(
        ORDER BY salary DESC
    ) AS row_num
FROM employees;

Priya | IT | 80000 | 1
Sneha | HR | 70000 | 2
Rahul | IT | 60000 | 3
Arun  | HR | 50000 | 4 -- Every row receives a unique number

-- when We want the latest order of every customer
SELECT *
FROM (
    SELECT
        order_id,
        customer_id,
        order_date,
        amount,
        ROW_NUMBER() OVER(
            PARTITION BY customer_id
            ORDER BY order_date DESC
        ) AS rn
    FROM orders
) t
WHERE rn = 1;

2. RANK(): Assigns the same rank to tied values
But it skips numbers after a tie

SELECT
    employee_name,
    salary,
    RANK() OVER(
        ORDER BY salary DESC
    ) AS salary_rank
FROM employees;

Suppose salariez are: 90000
                      80000
                      80000
                      70000
90000 -> 1
80000 -> 2
80000 - 2 --  Rank3 skipped
70000 -> 4


