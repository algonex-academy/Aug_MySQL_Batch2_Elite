SELECT
    order_date,
    sales,
    LAG(sales) OVER(
        ORDER BY order_date
    ) AS previous_sales,
    ROUND(
        (sales - LAG(sales) OVER(ORDER BY order_date))
        / LAG(sales) OVER(ORDER BY order_date) * 100,
        2
    ) AS growth_percentage
FROM daily_sales;

