Diff btw = vs IN

WHERE salary = (
    SELECT AVG(salary)
    FROM employees
) -- Result is possible

WHERE department_id = (
    SELECT department_id
    FROM departments
    WHERE location = 'Bengaluru'
) -- Result is not possible

-- IN Example(IN checks "Does this value belong to this result set?")
WHERE department_id IN ( 
    SELECT department_id
    FROM departments
    WHERE location = 'Bengaluru'
) 
-- Before choosing an operator, ask: What can my subquery return — one value or multiple values?

EXISTS: (Does at least one matching row exist?) - Correlated Subquery
Ex: Find customers who have placed at least one order(Same like IN)
SELECT * FROM customers c
WHERE EXISTS (
    SELECT 1
    FROM orders o
    WHERE o.customer_id = c.customer_id
); -- Return this customer if at least one matching order exists(correlated subquery)

/* IN is useful when I'm comparing a value against a set of returned values, while EXISTS is useful when I only need to know whether a matching row exists
The optimizer may transform these queries, so I wouldn't claim one is universally faster */

-- Correlated vs Non-Correlated Subquery(Imp for Interview)
Non-correlated: Inner query can execute independently
Ex: SELECT * FROM employees
WHERE salary > (
    SELECT AVG(salary)
    FROM employees
); -- Ikkada Inner query doesn't depend on outer query

-- Correlated: Inner query depends on the current row of the outer query
Ex: Find employees whose salary is greater than the average salary of their own department
SELECT * FROM employees e
WHERE salary > (
    SELECT AVG(e2.salary)
    FROM employees e2
    WHERE e2.department_id = e.department_id
);

        Non-correlated = inner query can run independently
        Correlated = inner query depends on the outer query's current row

Ex: Find employees whose salary is greater than their department's average salary
SELECT e.employee_id, e.name,e.salary, e.department_id
FROM employees e
WHERE e.salary > (
    SELECT AVG(e2.salary)
    FROM employees e2
    WHERE e2.department_id = e.department_id
);

NOT EXISTS — Real-Time Problem (Checks for no matching recordS)
Ex: Find customers who have NEVER placed an order
SELECT * FROM customers c
WHERE NOT EXISTS (
    SELECT 1
    FROM orders o
    WHERE o.customer_id = c.customer_id
);

