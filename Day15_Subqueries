-- ALL
Ex: Find employees whose salary is greater than every employee in department 10
SELECT * FROM employees
WHERE salary < ALL (
    SELECT salary
    FROM employees
    WHERE department_id = 10
);

            > ANY -> at least one
            > ALL -> every
salary > ANY (...) means salary > at least one of them
salary > ALL (...) means salary > 40000 and > 50000 and > 60000

-- Subquery in FROM(Derived table)
Ikkada prathisari A subquery doesn't have to be inside WHERE

SELECT department_id, avg_salary
FROM (                   -- A subquery in FROM is commonly called a derived table
    SELECT department_id,
           AVG(salary) AS avg_salary
    FROM employees
    GROUP BY department_id
) AS dept_stats; -- Here the subquery acts like a temporary result set/table for the outer query

FROM (subquery) AS alias -- The alias is required for this derived table in MySQ

