26. INNER JOIN
Display: customer_name 
         order_id
         total_amount for customers who have placed orders - Write the query
SELECT
    c.customer_name,
    o.order_id,
    o.total_amount
FROM customers c
INNER JOIN orders o
    ON c.customer_id = o.customer_id; -- Why? We only need customers who have matching orders

27. LEFT JOIN
Display all customers, including customers who have never placed an order
Return:
customer_name
order_id
total_amount

SELECT
    c.customer_name,
    o.order_id,
    o.total_amount
FROM customers c
LEFT JOIN orders o
    ON c.customer_id = o.customer_id; -- Why? We need all customers, including those without orders

28. Multi-table JOIN
Display:
customer_name
order_id
store_name
total_amount -- Use the required JOINs

SELECT
    c.customer_name,
    o.order_id,
    s.store_name,
    o.total_amount
FROM customers c
INNER JOIN orders o
    ON c.customer_id = o.customer_id
INNER JOIN stores s
    ON o.store_id = s.store_id;

29. Filter After JOIN
Display customers and their orders where:
total_amount > 1000

SELECT
    c.customer_name,
    o.order_id,
    o.total_amount
FROM customers c
INNER JOIN orders o
    ON c.customer_id = o.customer_id
WHERE o.total_amount > 1000;

30. Unmatched Records
Find customers who have never placed an order
Return: customer_id
        customer_name

SELECT
    c.customer_id,
    c.customer_name
FROM customers c
LEFT JOIN orders o
    ON c.customer_id = o.customer_id
WHERE o.customer_id IS NULL;

