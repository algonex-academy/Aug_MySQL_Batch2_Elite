###Practical lab— Commands and data types together

CREATE DATABASE IF NOT EXISTS mysql_learning;
USE mysql_learning;

CREATE TABLE datatype_lab (
    record_id BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,

    short_code CHAR(3) NOT NULL,
    display_name VARCHAR(100) NOT NULL,

    quantity INT UNSIGNED NOT NULL DEFAULT 0,
    unit_price DECIMAL(10, 2) NOT NULL,
    measured_weight DOUBLE NULL,

    event_date DATE NULL,
    occurred_at DATETIME NULL,

    is_active BOOLEAN NOT NULL DEFAULT TRUE,
    notes TEXT NULL,
    metadata JSON NULL,

    CONSTRAINT pk_datatype_lab
        PRIMARY KEY (record_id),

    CONSTRAINT uq_datatype_lab_short_code
        UNIQUE (short_code),

    CONSTRAINT chk_datatype_lab_price
        CHECK (unit_price >= 0),

    CONSTRAINT chk_datatype_lab_is_active
        CHECK (is_active IN (0, 1))
);

-- Chesinaa Tableni inspect cheyu
DESCRIBE datatype_lab;
SHOW CREATE TABLE datatype_lab;

-- Datani inset cheyu
INSERT INTO datatype_lab (
    short_code,
    display_name,
    quantity,
    unit_price,
    measured_weight,
    event_date,
    occurred_at,
