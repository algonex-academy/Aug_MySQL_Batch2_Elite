-- PRIMARY KEY: Uniquely identifies every row
CREATE TABLE students (
    student_id INT PRIMARY KEY,
    name VARCHAR(100)
);
#Rules:
Cannot contain NULL
Must be unique
A table has one primary key definition
It can consist of multiple columns -> composite primary key
